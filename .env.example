# --- The AI ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
FIELDMATE_MODEL=gemini-2.5-flash

# --- Your business ---
BUSINESS_NAME=Declan's Plumbing & Heating
# Your own WhatsApp number in E.164 (only these numbers can use the bot)
OWNER_NUMBERS=+353870000000

# --- Safety ---
# true = messages to CUSTOMERS are printed, not sent. Keep true while learning.
DRY_RUN=true
VISION_MIN_CONFIDENCE=0.8
JOBS_TOKEN=change-me-to-something-random

# --- Storage (defaults are fine) ---
DATABASE_URL=sqlite:///fieldmate.db
SESSION_DB_URL=sqlite+aiosqlite:///fieldmate_sessions.db

# --- Twilio (only needed for real WhatsApp, step 6 of GUIDE.md) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
VALIDATE_TWILIO_SIGNATURE=true
